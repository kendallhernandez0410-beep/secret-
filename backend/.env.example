# SecureVault Environment Variables (Template)
# IMPORTANTE: Nunca almacenar valores reales en control de versiones

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Criptografía
# Master Key AES-256-GCM (Exactamente 32 bytes en formato hex = 64 caracteres)
# Generar con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret (Mínimo 256 bits = 32 bytes en hex)
JWT_SECRET=super_secure_jwt_secret_key_minimum_32_bytes_long_random_value

# Configuración de Base de Datos
DATABASE_PATH=./data/securevault.db

# Configuración de Red y Proxy
TRUST_PROXY=false
ALLOWED_ORIGIN=http://localhost:3000
